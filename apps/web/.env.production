# Production environment variables for Tuiton Web App
# Copy this file to .env.production and fill in the values

# ─────────────────────────────────────────────
# Database Configuration (PostgreSQL for Production)
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://tuiton:development_password_change_in_prod@localhost:5432/tuiton?schema=public&connection_limit=10"

# ─────────────────────────────────────────────
# Authentication Secrets
# ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="<generate-a-secure-32-char-secret>"

# ─────────────────────────────────────────────
# App Configuration
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Tuiton"
NEXT_PUBLIC_APP_URL="https://tuiton.app"

# ─────────────────────────────────────────────
# Google OAuth Configuration (for real deployment)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://tuiton.app/api/auth/google/callback"

# ─────────────────────────────────────────────
# SMS/OTP Provider (MSG91 for India)
# ─────────────────────────────────────────────
MSG91_AUTH_KEY="your-msg91-auth-key"

# ─────────────────────────────────────────────
# Optional: Redis for Sessions & Caching
# ─────────────────────────────────────────────
# REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────
# Optional: Jitsi Video Configuration
# ─────────────────────────────────────────────
# JITSI_JWS_KEY="your-jwt-signing-key"
# JITSI_JWS_APP_ID="tuiton"

# ─────────────────────────────────────────────
# Optional: Email Configuration (Resend, SES, etc.)
# ─────────────────────────────────────────────
# EMAIL_API_KEY="your-email-provider-key"
# EMAIL_FROM="noreply@tuiton.app"
# AI Tutor Configuration
NVIDIA_API_KEY="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"